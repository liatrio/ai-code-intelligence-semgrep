# Override the lab state directory if the default ~/.cache location is
# unsuitable (e.g. shared machine, encrypted FS, CI). Everything setup.py
# writes stays inside this directory.
# SEMGREP_LAB_STATE=/absolute/path/to/state

# By default Semgrep sends anonymous usage metrics to metrics.semgrep.dev
# unless a scan is run with `--metrics=off`. Setup.py + the harness always
# pass `--metrics=off`; this env var pins the same behaviour for any manual
# CLI invocation you do outside the harness.
SEMGREP_SEND_METRICS=off

# DO NOT SET `SEMGREP_APP_TOKEN`. Setting it enables `semgrep login` /
# AppSec Platform / Pro engine paths, which upload findings and are OUT
# OF SCOPE per issue #80 (liatrio-knowledge is private).
# SEMGREP_APP_TOKEN=
